# ---------------------------------------------------------------------------
# Copy this file to `.env` and fill in your values:
#     cp .env.example .env
#
# `.env` is gitignored. NEVER commit it. NEVER paste your private key
# anywhere else. Use a burner wallet funded with only what you're bridging.
# ---------------------------------------------------------------------------


# === REQUIRED ==============================================================

# Private key of the wallet doing the bridging, with the 0x prefix.
# Must be a plain EOA — Circle Gateway does not accept smart-contract wallet
# signatures. Export from MetaMask: Account details -> Show private key.
PRIVATE_KEY=0xyour_private_key_here


# === WHAT TO BRIDGE ========================================================

# Amount of USDC to receive on Arc (human units, not wei).
# Start with 1 or 2 for your first run.
AMOUNT_USDC=2

# Where the USDC lands on Arc. Leave blank to use your own address.
RECIPIENT=

# Extra USDC deposited on top of AMOUNT_USDC to cover Circle's fee.
# The Gateway fee has been a flat 0.01 USDC; 0.05 is comfortable headroom.
# Your Gateway balance must cover AMOUNT + fee or /transfer rejects the
# request with the exact amount it needed.
MAX_FEE_USDC=0.05


# === NETWORK ===============================================================

# "testnet" (Base Sepolia -> Arc Testnet) or "mainnet" (real funds).
# Do a testnet run first if you've never done this before.
NETWORK=mainnet

# Arc RPC endpoint. Required for mainnet.
ARC_RPC_URL=https://rpc.blockdaemon.mainnet.arc.io/

# Base RPC. Optional but RECOMMENDED — the default public RPC
# load-balances across nodes, which causes intermittent
# "transfer amount exceeds allowance" and "Block ... could not be found"
# errors. A dedicated endpoint (Alchemy, QuickNode, your own node)
# eliminates them.
BASE_RPC_URL=


# === OPTIONAL / ADVANCED ===================================================

# Upper bound in minutes for the deposit finality countdown display.
# Circle waits ~65 Ethereum blocks for Base deposits: 13-19 min typically.
# Purely cosmetic — it does not change how long Circle actually takes.
FINALITY_MAX_MINUTES=19

# Additional headers for Gateway API calls, "Key: value".
# Newline- or comma-separated for multiple.
# NOTE: the Arc private-mainnet header is already sent by default —
# you do NOT need to add it here. See the README section on that flag.
GW_EXTRA_HEADERS=

# Override Arc chain identifiers. Defaults: domain 26, chain ID 5042
# (mainnet) / 5042002 (testnet). Only set these if Circle or Arc changes them.
ARC_DOMAIN=
ARC_CHAIN_ID=
ARC_USDC=

